<template id="external_layout_footer">
    <div class="footer">
                  <div class="baspage" >Edition du <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M')"/>
                  </div>
<center><span>Page </span><span class="page" /> de <span class="topage" /></center>
    </div>      
</template>
        </t>

        </t>
	     </t>
</template>

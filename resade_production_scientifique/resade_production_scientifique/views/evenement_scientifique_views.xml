<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_evenement_scientifique_form" model="ir.ui.view">
        <field name="name">resade.evenement.scientifique.form</field>
        <field name="model">resade.evenement.scientifique</field>
        <field name="arch" type="xml">
            <form string="Événement Scientifique">
                <header>
                    <button name="action_confirmer" string="Confirmer"
                            type="object" class="btn-primary"
                            invisible="state != 'planifie'"/>
                    <button name="action_demarrer" string="En cours"
                            type="object"
                            invisible="state != 'confirme'"/>
                    <button name="action_terminer" string="Terminer"
                            type="object" class="btn-success"
                            invisible="state != 'en_cours'"/>
                    <button name="action_annuler" string="Annuler"
                            type="object" class="btn-danger"
                            invisible="state in ['termine','annule']"
                            groups="resade_production_scientifique.group_resade_scientifique_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="planifie,confirme,en_cours,termine"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                        <h2><field name="titre" placeholder="Titre de l événement..."/></h2>
                    </div>
                    <group>
                        <group string="Caractéristiques">
                            <field name="type_evenement"/>
                            <field name="mode_participation"/>
                            <field name="responsable_id"/>
                            <field name="participants_internes_ids" widget="many2many_tags"/>
                            <field name="nb_participants_externes"/>
                        </group>
                        <group string="Localisation et Dates">
                            <field name="date_debut"/>
                            <field name="date_fin"/>
                            <field name="en_ligne"/>
                            <field name="lieu" invisible="en_ligne"/>
                            <field name="pays" invisible="en_ligne"/>
                            <field name="url_evenement" invisible="not en_ligne"/>
                        </group>
                    </group>
                    <group string="Budget">
                        <group>
                            <field name="budget_estime"/>
                            <field name="source_financement"/>
                            <field name="frais_inscription"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contribution RESADE">
                            <group>
                                <field name="titre_communication"/>
                                <field name="type_communication"/>
                            </group>
                            <field name="resume_communication" placeholder="Résumé de la communication soumise..."/>
                        </page>
                        <page string="Compte-rendu">
                            <group>
                                <group>
                                    <field name="diffusion_interne"/>
                                    <field name="diffusion_site_web"/>
                                    <field name="lien_enregistrement"/>
                                </group>
                                <group>
                                    <field name="presentation_fichier" filename="presentation_filename" widget="binary"/>
                                    <field name="presentation_filename"/>
                                    <field name="certificat" filename="certificat_filename" widget="binary"/>
                                    <field name="certificat_filename"/>
                                </group>
                            </group>
                            <field name="compte_rendu" placeholder="Compte-rendu de participation..."/>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_evenement_scientifique_list" model="ir.ui.view">
        <field name="name">resade.evenement.scientifique.list</field>
        <field name="model">resade.evenement.scientifique</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'termine'"
                  decoration-info="state in ['confirme','en_cours']"
                  decoration-muted="state == 'annule'">
                <field name="reference"/>
                <field name="titre"/>
                <field name="type_evenement"/>
                <field name="mode_participation"/>
                <field name="responsable_id"/>
                <field name="date_debut"/>
                <field name="pays"/>
                <field name="en_ligne" widget="boolean_toggle"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_evenement_calendar" model="ir.ui.view">
        <field name="name">resade.evenement.scientifique.calendar</field>
        <field name="model">resade.evenement.scientifique</field>
        <field name="arch" type="xml">
            <calendar string="Calendrier Événements" date_start="date_debut" date_stop="date_fin"
                      color="type_evenement" mode="month">
                <field name="titre"/>
                <field name="responsable_id"/>
            </calendar>
        </field>
    </record>

    <record id="action_evenement_scientifique" model="ir.actions.act_window">
        <field name="name">Événements Scientifiques</field>
        <field name="res_model">resade.evenement.scientifique</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun événement enregistré</p>
            <p>Processus P-CI-07 et P-CI-09 — Participation et organisation d événements scientifiques</p>
        </field>
    </record>
</odoo>

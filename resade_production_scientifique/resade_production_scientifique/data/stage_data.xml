<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Thématiques de recherche RESADE (données de référence) -->

    <record id="thematique_sante_publique" model="resade.thematique">
        <field name="name">Santé publique</field>
        <field name="code">SP</field>
        <field name="color">1</field>
    </record>

    <record id="thematique_epidemiologie" model="resade.thematique">
        <field name="name">Épidémiologie</field>
        <field name="code">EPI</field>
        <field name="color">2</field>
    </record>

    <record id="thematique_economie_sante" model="resade.thematique">
        <field name="name">Économie de la santé</field>
        <field name="code">ECO</field>

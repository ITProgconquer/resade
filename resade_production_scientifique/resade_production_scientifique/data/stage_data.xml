    <record id="thematique_politique_sante" model="resade.thematique">
        <field name="name">Politique &amp; Systèmes de santé</field>
        <field name="code">PSS</field>
        <field name="color">4</field>
    </record>

    <record id="thematique_financement" model="resade.thematique">
        <field name="name">Financement de la santé / CSU</field>

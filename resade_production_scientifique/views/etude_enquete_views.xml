<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_etude_enquete_form" model="ir.ui.view">
        <field name="name">resade.etude.enquete.form</field>
        <field name="model">resade.etude.enquete</field>
        <field name="arch" type="xml">
            <form string="Étude / Enquête Terrain">
                <header>
                    <button name="action_demarrer" string="Démarrer la collecte"
                            type="object" class="btn-primary"
                            invisible="state != 'preparation'"/>
                    <button name="action_saisie" string="Saisie et nettoyage"
                            type="object" invisible="state != 'en_cours'"/>
                    <button name="action_analyser" string="Lancer analyse"
                            type="object" invisible="state != 'saisie'"/>
                    <button name="action_terminer" string="Terminer"
                            type="object" class="btn-success"
                            invisible="state not in ['analyse','rapport']"
                            groups="resade_production_scientifique.group_resade_scientifique_pi"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="preparation,en_cours,saisie,analyse,termine"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_voir_donnees" type="object"
                                class="oe_stat_button" icon="fa-database">
                            <field name="donnees_count" widget="statinfo" string="Données"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                        <h2><field name="titre" placeholder="Titre de l étude..."/></h2>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="protocole_id"/>
                            <field name="type_etude"/>
                            <field name="zone_etude"/>
                        </group>
                        <group string="Responsables">
                            <field name="investigateur_principal_id"/>
                            <field name="coordinateur_terrain_id"/>
                            <field name="equipe_terrain_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group>
                        <group string="Calendrier">
                            <field name="date_debut"/>
                            <field name="date_fin_prevue"/>
                            <field name="date_fin_reelle"/>
                        </group>
                        <group string="Collecte">
                            <field name="taille_echantillon"/>
                            <field name="taille_echantillon_reel"/>
                            <field name="outil_collecte"/>
                            <field name="consentement_eclaire"/>
                        </group>
                    </group>
                    <group>
                        <field name="taux_avancement" widget="progressbar"/>
                    </group>
                    <notebook>
                        <page string="Suivi terrain">
                            <field name="difficultes" placeholder="Difficultés rencontrées..."/>
                            <field name="mesures_correctives" placeholder="Mesures correctives..."/>
                        </page>
                        <page string="Documents">
                            <group>
                                <group string="Guide entretien">
                                    <field name="guide_entretien" filename="guide_entretien_filename" widget="binary"/>
                                    <field name="guide_entretien_filename"/>
                                </group>
                                <group string="Rapport terrain">
                                    <field name="rapport_terrain" filename="rapport_terrain_filename" widget="binary"/>
                                    <field name="rapport_terrain_filename"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_etude_enquete_list" model="ir.ui.view">
        <field name="name">resade.etude.enquete.list</field>
        <field name="model">resade.etude.enquete</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'termine'" decoration-info="state == 'en_cours'">
                <field name="reference"/>
                <field name="titre"/>
                <field name="type_etude"/>
                <field name="investigateur_principal_id"/>
                <field name="date_debut"/>
                <field name="date_fin_prevue"/>
                <field name="taux_avancement" widget="progressbar"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_etude_enquete" model="ir.actions.act_window">
        <field name="name">Études et Enquêtes Terrain</field>
        <field name="res_model">resade.etude.enquete</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre première étude terrain</p>
            <p>Processus P-CI-02 — Conduite des études et enquêtes terrain</p>
        </field>
    </record>

</odoo>

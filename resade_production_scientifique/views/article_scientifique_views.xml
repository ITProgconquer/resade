<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_article_scientifique_form" model="ir.ui.view">
        <field name="name">resade.article.scientifique.form</field>
        <field name="model">resade.article.scientifique</field>
        <field name="arch" type="xml">
            <form string="Article Scientifique">
                <header>
                    <button name="action_envoyer_revue_interne" string="Envoyer en revue interne"
                            type="object" class="btn-primary"
                            invisible="state != 'brouillon'"/>
                    <button name="action_valider_interne" string="Valider (DE)"
                            type="object" class="btn-success"
                            invisible="state not in ['revue_interne','revision']"
                            groups="resade_production_scientifique.group_resade_scientifique_manager"/>
                    <button name="action_marquer_soumis" string="Marquer soumis"
                            type="object"
                            invisible="state != 'valide_interne'"/>
                    <button name="action_marquer_accepte" string="Accepté"
                            type="object" class="btn-success"
                            invisible="state not in ['soumis','revision_externe']"/>
                    <button name="action_marquer_publie" string="Publié"
                            type="object" class="btn-success"
                            invisible="state != 'accepte'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="brouillon,revue_interne,valide_interne,soumis,accepte,publie"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_voir_soumissions" type="object"
                                class="oe_stat_button" icon="fa-send">
                            <field name="soumission_count" widget="statinfo" string="Soumissions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                        <h2><field name="titre" placeholder="Titre de l article..."/></h2>
                        <field name="titre_court" placeholder="Titre court (running head)..."/>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="type_article"/>
                            <field name="sutr" invisible="type_article != 'autre'"/>
                            <field name="langue"/>
                            <field name="nb_mots"/>
                            <field name="mots_cles"/>
                        </group>
                        <group string="Source">
                            <field name="protocole_id"/>
                            <field name="etude_id"/>
                            <field name="projet_id"/>
                        </group>
                    </group>
                    <group string="Auteurs">
                        <group>
                            <field name="auteur_correspondant_id"/>
                            <field name="auteurs_ids" widget="many2many_tags"/>
                            <field name="auteurs_externes"/>
                        </group>
                        <group>
                            <field name="declaration_coi"/>
                            <field name="source_financement"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Résumé">
                            <field name="resume" placeholder="Abstract / Résumé..."/>
                        </page>
                        <page string="Revue interne">
                            <group>
                                <group>
                                    <field name="reviewers_internes_ids" widget="many2many_tags"/>
                                    <field name="date_revue_interne"/>
                                    <field name="date_retour_revue"/>
                                    <field name="date_finalisation"/>
                                </group>
                                <group>
                                    <field name="grille_revue" filename="grille_revue_filename" widget="binary"/>
                                    <field name="grille_revue_filename"/>
                                </group>
                            </group>
                            <field name="commentaires_revue_interne" widget="html" placeholder="Commentaires des relecteurs internes..."/>
                        </page>
                        <page string="Manuscrit">
                            <group>
                                <field name="manuscrit" filename="manuscrit_filename" widget="binary"/>
                                <field name="manuscrit_filename"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_article_scientifique_list" model="ir.ui.view">
        <field name="name">resade.article.scientifique.list</field>
        <field name="model">resade.article.scientifique</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'publie'"
                  decoration-info="state == 'accepte'"
                  decoration-warning="state in ['revue_interne','revision']">
                <field name="reference"/>
                <field name="titre"/>
                <field name="type_article"/>
                <field name="auteur_correspondant_id"/>
                <field name="langue"/>
                <field name="date_creation"/>
                <field name="soumission_count" string="Soumissions"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'publie'"
                       decoration-info="state == 'accepte'"
                       decoration-warning="state in ['revue_interne','revision']"/>
            </list>
        </field>
    </record>

    <record id="view_article_scientifique_kanban" model="ir.ui.view">
        <field name="name">resade.article.scientifique.kanban</field>
        <field name="model">resade.article.scientifique</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="reference"/>
                <field name="titre"/>
                <field name="auteur_correspondant_id"/>
                <field name="state"/>
                <field name="type_article"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="titre"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <span><field name="type_article"/></span><br/>
                                    <span><field name="auteur_correspondant_id"/></span>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left text-muted">
                                        <field name="reference"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_article_search" model="ir.ui.view">
        <field name="name">resade.article.scientifique.search</field>
        <field name="model">resade.article.scientifique</field>
        <field name="arch" type="xml">
            <search>
                <field name="titre"/>
                <field name="auteur_correspondant_id"/>
                <field name="reference"/>
                <separator/>
                <filter string="Publiés" name="publie" domain="[('state','=','publie')]"/>
                <filter string="Acceptés" name="accepte" domain="[('state','=','accepte')]"/>
                <filter string="En revue" name="revue" domain="[('state','in',['revue_interne','revision'])]"/>
                <filter string="Validés internement" name="valide" domain="[('state','=','valide_interne')]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Type" name="gr_type" context="{'group_by':'type_article'}"/>
                    <filter string="Statut" name="gr_state" context="{'group_by':'state'}"/>
                    <filter string="Auteur correspondant" name="gr_auteur" context="{'group_by':'auteur_correspondant_id'}"/>
                    <filter string="Langue" name="gr_langue" context="{'group_by':'langue'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_article_scientifique" model="ir.actions.act_window">
        <field name="name">Articles Scientifiques</field>
        <field name="res_model">resade.article.scientifique</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_article_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre premier article scientifique</p>
            <p>Processus P-CI-04 — Rédaction et revue interne des articles scientifiques</p>
        </field>
    </record>
</odoo>

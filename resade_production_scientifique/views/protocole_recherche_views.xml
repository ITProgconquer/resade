<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_protocole_recherche_form" model="ir.ui.view">
        <field name="name">resade.protocole.recherche.form</field>
        <field name="model">resade.protocole.recherche</field>
        <field name="arch" type="xml">
            <form string="Protocole de Recherche">
                <header>
                    <button name="action_soumettre_revue" string="Soumettre à revue interne"
                            type="object" class="btn-primary"
                            invisible="state != 'brouillon'"/>
                    <button name="action_soumettre_ethique" string="Soumettre au CERS"
                            type="object" class="btn-primary"
                            invisible="state != 'revue_interne'"/>
                    <button name="action_avis_favorable" string="Avis CERS favorable"
                            type="object" class="btn-success"
                            invisible="state != 'soumission_ethique'"/>
                    <button name="action_valider" string="Valider (DE)"
                            type="object" class="btn-success"
                            invisible="state not in ['avis_ethique_recu','revue_interne']"
                            groups="resade_production_scientifique.group_resade_scientifique_manager"/>
                    <button name="action_rejeter" string="Rejeter"
                            type="object" class="btn-danger"
                            invisible="state in ['rejete','archive','valide']"/>
                    <button name="action_archiver" string="Archiver"
                            type="object"
                            invisible="state != 'valide'"
                            groups="resade_production_scientifique.group_resade_scientifique_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="brouillon,revue_interne,soumission_ethique,avis_ethique_recu,valide"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_voir_etudes" type="object"
                                class="oe_stat_button" icon="fa-flask">
                            <field name="etude_count" widget="statinfo" string="Études"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="reference"/>
                        <h1><field name="reference" readonly="1"/></h1>
                        <label for="titre"/>
                        <h2><field name="titre" placeholder="Titre du protocole..."/></h2>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="acronyme"/>
                            <field name="domaine_recherche"/>
                            <field name="projet_id"/>
                            <field name="date_creation"/>
                            <field name="duree_mois"/>
                        </group>
                        <group string="Responsables (RACI)">
                            <field name="investigateur_principal_id"/>
                            <field name="responsable_validation_id"/>
                            <field name="equipe_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contenu scientifique" name="contenu">
                            <field name="objectif_general" placeholder="Objectif général du protocole..."/>
                            <field name="hypotheses" placeholder="Hypothèses de recherche..."/>
                            <field name="methodologie" placeholder="Méthodologie..."/>
                            <field name="population_cible" placeholder="Population cible / Zone d étude..."/>
                        </page>
                        <page string="Éthique et Conformité" name="ethique">
                            <group>
                                <group string="Autorisations requises">
                                    <field name="necessite_ethique"/>
                                    <field name="necessite_visa_stat"/>
                                    <field name="necessite_autorisation_msante"/>
                                </group>
                                <group string="Statut CERS">
                                    <field name="date_soumission_ethique"/>
                                    <field name="date_avis_ethique"/>
                                    <field name="avis_ethique"/>
                                    <field name="numero_autorisation_cers"/>
                                </group>
                            </group>
                            <field name="commentaires_ethique" placeholder="Commentaires CERS..."/>
                            <group>
                                <group string="Visa statistique (INSD)">
                                    <field name="date_visa_statistique"/>
                                </group>
                                <group string="Validation interne">
                                    <field name="date_validation_interne"/>
                                    <field name="date_demarrage_prevu"/>
                                </group>
                            </group>
                        </page>
                        <page string="Documents" name="documents">
                            <group>
                                <group string="Protocole">
                                    <field name="formulaire_protocole" filename="formulaire_protocole_filename" widget="binary"/>
                                    <field name="formulaire_protocole_filename"/>
                                </group>
                                <group string="Consentement">
                                    <field name="formulaire_consentement" filename="formulaire_consentement_filename" widget="binary"/>
                                    <field name="formulaire_consentement_filename"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes internes" name="notes">
                            <field name="notes_internes" placeholder="Notes internes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_protocole_recherche_list" model="ir.ui.view">
        <field name="name">resade.protocole.recherche.list</field>
        <field name="model">resade.protocole.recherche</field>
        <field name="arch" type="xml">
            <list string="Protocoles de Recherche"
                  decoration-success="state == 'valide'"
                  decoration-warning="state in ['revue_interne','soumission_ethique']"
                  decoration-danger="state == 'rejete'">
                <field name="reference"/>
                <field name="titre"/>
                <field name="domaine_recherche"/>
                <field name="investigateur_principal_id"/>
                <field name="date_creation"/>
                <field name="avis_ethique"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'valide'"
                       decoration-warning="state in ['revue_interne','soumission_ethique','avis_ethique_recu']"
                       decoration-danger="state == 'rejete'"/>
            </list>
        </field>
    </record>

    <record id="view_protocole_recherche_search" model="ir.ui.view">
        <field name="name">resade.protocole.recherche.search</field>
        <field name="model">resade.protocole.recherche</field>
        <field name="arch" type="xml">
            <search string="Rechercher protocoles">
                <field name="reference"/>
                <field name="titre"/>
                <field name="investigateur_principal_id"/>
                <separator/>
                <filter string="Validés" name="valide" domain="[('state','=','valide')]"/>
                <filter string="En cours de validation" name="en_cours"
                        domain="[('state','in',['revue_interne','soumission_ethique','avis_ethique_recu'])]"/>
                <filter string="Brouillons" name="brouillon" domain="[('state','=','brouillon')]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Domaine" name="gr_domaine" context="{'group_by':'domaine_recherche'}"/>
                    <filter string="Statut" name="gr_state" context="{'group_by':'state'}"/>
                    <filter string="Investigateur" name="gr_pi" context="{'group_by':'investigateur_principal_id'}"/>
                    <filter string="Année" name="gr_annee" context="{'group_by':'date_creation:year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_protocole_recherche" model="ir.actions.act_window">
        <field name="name">Protocoles de Recherche</field>
        <field name="res_model">resade.protocole.recherche</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_protocole_recherche_search"/>
        <field name="context">{'search_default_en_cours': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre premier protocole de recherche</p>
            <p>Processus P-CI-01 — Conception et validation d un protocole de recherche</p>
        </field>
    </record>

</odoo>

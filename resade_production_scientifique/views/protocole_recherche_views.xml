<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_protocole_recherche_form" model="ir.ui.view">
        <field name="name">resade.protocole.recherche.form</field>
        <field name="model">resade.protocole.recherche</field>
        <field name="arch" type="xml">
            <form string="Protocole de Recherche">
                <header>
                    <button name="action_soumettre_revue" string="Soumettre à revue interne"
                            type="object" class="btn-primary"
                            invisible="state != 'brouillon'"
                            groups="resade_production_scientifique.group_resade_scientifique_pi"/>

                    <button name="action_soumettre_ethique" string="Soumettre au CERS"
                            type="object" class="btn-primary"
                            invisible="state != 'revue_interne' or not necessite_ethique"
                            groups="resade_production_scientifique.group_resade_scientifique_pi"/>

                    <button name="action_avis_favorable" string="Avis CERS favorable"
                            type="object" class="btn-success"
                            invisible="state != 'soumission_ethique' or not necessite_ethique"
                            groups="resade_production_scientifique.group_resade_scientifique_manager"/>
                            
                    <button name="action_valider" string="Valider (DE)"
                            type="object" class="btn-success"
                            invisible="state not in ['avis_ethique_recu', 'revue_interne','visa_statistique','visa_statistique_recu', 'autorisation_ministere_recue'] or (necessite_ethique and not date_avis_ethique) or  (necessite_visa_stat and not date_avis_visa_statistique) or (necessite_autorisation_msante and not date_avis_ministere)"
                            groups="resade_production_scientifique.group_resade_scientifique_manager"/>

                    <button name="action_visa_statistique" string="Visa statistique" 
                            type="object" class="btn-secondary"
                            invisible="state != 'avis_ethique_recu' or not necessite_visa_stat"
                            groups="resade_production_scientifique.group_resade_scientifique_pi"/>
                    
                    <button name="action_msanté" string="Soumission MSANTE" 
                            type="object" class="btn-secondary"
                            invisible="state != 'avis_ethique_recu' or not necessite_autorisation_msante "
                            groups="resade_production_scientifique.group_resade_scientifique_pi"/>

                    <button name="action_soumettre_visa" string="Soumettre Visa INSD" type="object" class="btn-secondary"
                            invisible="state != 'visa_statistique' or not necessite_visa_stat"
                            groups="resade_production_scientifique.group_resade_scientifique_pi"/>

                    <button name="action_avis_visa_recu" string="Avis Visa Reçu" type="object" class="btn-primary"
                            invisible="state != 'soumission_visa' or not necessite_visa_stat"
                            groups="resade_production_scientifique.group_resade_scientifique_manager"/>

                    <button name="action_soumettre_ministere" string="Soumettre au Ministère" type="object" class="btn-secondary"
                            invisible="state not in ['msante_en', 'visa_statistique_recu'] or not necessite_autorisation_msante"
                            groups="resade_production_scientifique.group_resade_scientifique_pi"/>

                    <button name="action_avis_ministere_recu" string="Avis Ministère Reçu" type="object" class="btn-primary"
                            invisible="state != 'soumission_ministere' or not necessite_autorisation_msante"
                             groups="resade_production_scientifique.group_resade_scientifique_manager"/>

                    <button name="action_rejeter" string="Rejeter"
                            type="object" class="btn-danger"
                            invisible="state in ['rejete','archive','valide']"
                            groups="resade_production_scientifique.group_resade_scientifique_manager"/>

                    <button name="action_archiver" string="Archiver"
                            type="object"
                            invisible="state != 'valide'"
                            groups="resade_production_scientifique.group_resade_scientifique_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="brouillon,revue_interne,soumission_ethique,avis_ethique_recu,valide"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_voir_etudes" type="object"
                                class="oe_stat_button" icon="fa-flask">
                            <field name="etude_count" widget="statinfo" string="Études"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="reference"/>
                        <h1><field name="reference" readonly="1"/></h1>
                        <label for="name"/>
                        <h2><field name="name" placeholder="name du protocole..."/></h2>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="acronyme"/>
                            <field name="domaine_recherche_ids" widget="many2many_tags"/>
                            <field name="projet_id"/>
                            <field name="date_creation"/>
                            <field name="duree_mois"/>
                        </group>
                        <group string="Responsables (RACI)">
                            <field name="investigateur_principal_id"/>
                            <field name="responsable_validation_id"/>
                            <field name="equipe_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contenu scientifique" name="contenu">
                                
                            <field name="objectif_general" widget="html" nolabel="1" colspan="2" placeholder="Objectif..."/>
                            
                            <field name="hypotheses" widget="html" nolabel="1" colspan="2" placeholder="Hypothèses de recherche..."/>
                            <field name="population_cible" widget="html" nolabel="1" colspan="2" placeholder="Population cible "/>
                            <field name="zone_etude" widget="html" nolabel="1" colspan="2" placeholder=" Zone d étude..."/>
                        </page>
                        <page string="🔬 Méthodologie" name="methodologie">
                           
                            <field name="type_etude" widget="html" nolabel="1" colspan="2" placeholder="Décrivez le type d'étude (transversale, cohorte...)"/>
                        
                            <field name="cadre_etude" widget="html" nolabel="1" colspan="2" placeholder="Cadre de l'étude et période..."/>
                        
                            <field name="echantillonnage" widget="html" nolabel="1" colspan="2" placeholder="Méthode d'échantillonnage..."/>
                        
                            <field name="outils_collecte" widget="html" nolabel="1" colspan="2" placeholder="Outils et méthode de collecte..."/>
                        
                            <field name="analyse_donnees" widget="html" nolabel="1" colspan="2" placeholder="Méthodes d'analyse..."/>
                        
                        </page>
                        <page string="Éthique et Conformité" name="ethique">
                            <group>
                                <group string="Autorisations requises">
                                    <field name="necessite_ethique"/>
                                    <field name="necessite_visa_stat"/>
                                    <field name="necessite_autorisation_msante"/>
                                </group>
                                <group string="Statut CERS">
                                    <field name="date_soumission_ethique"/>
                                    <field name="date_avis_ethique"/>
                                    <field name="avis_ethique"/>
                                    <field name="numero_autorisation_cers"/>
                                    <field name="commentaires_ethique" placeholder="Commentaires CERS..."/>
                                </group>
                            </group>
                           
                            <group>
                                <group string="Visa statistique (INSD)">
                                    <field name="date_soumission_visa_statistique"/>
                                    <field name="date_avis_visa_statistique"/>
                                    <field name="commentaire_visa_statistique" widget="html" nolabel="1" colspan="2" placeholder="Commentaires Visa Statistique..."/>
                                </group>
                                <group string="Autorisation Ministère" invisible="not necessite_autorisation_msante">
                                    <field name="date_soumission_ministere"/>
                                    <field name="date_avis_ministere"/>
                                    <field name="commentaire_ministere" widget="html" nolabel="1" colspan="2" placeholder="Commentaires Ministère..."/>
                                </group>
                                <group string="Validation interne">
                                    <field name="date_validation_interne"/>
                                    <field name="date_demarrage_prevu"/>
                                </group>
                            </group>
                        </page>
                        <page string="Documents" name="documents">
                            <group>
                                <group string="Protocole">
                                    <field name="formulaire_protocole" widget="many2many_binary"/>
                                </group>
                                <group string="Consentement">
                                    <field name="formulaire_consentement" widget="many2many_binary"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes internes" name="notes">
                            <field name="notes_internes" placeholder="Notes internes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_protocole_recherche_list" model="ir.ui.view">
        <field name="name">resade.protocole.recherche.list</field>
        <field name="model">resade.protocole.recherche</field>
        <field name="arch" type="xml">
            <list string="Protocoles de Recherche"
                  decoration-success="state == 'valide'"
                  decoration-warning="state in ['revue_interne','soumission_ethique']"
                  decoration-danger="state == 'rejete'">
                <field name="reference"/>
                <field name="name"/>
                <field name="domaine_recherche_ids" widget="many2many_tags"/>
                <field name="investigateur_principal_id"/>
                <field name="date_creation"/>
                <field name="avis_ethique"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'valide'"
                       decoration-warning="state in ['revue_interne','soumission_ethique','avis_ethique_recu']"
                       decoration-danger="state == 'rejete'"/>
            </list>
        </field>
    </record>

    <record id="view_protocole_recherche_search" model="ir.ui.view">
        <field name="name">resade.protocole.recherche.search</field>
        <field name="model">resade.protocole.recherche</field>
        <field name="arch" type="xml">
            <search string="Rechercher protocoles">
                <field name="reference"/>
                <field name="name"/>
                <field name="investigateur_principal_id"/>
                <separator/>
                <filter string="Validés" name="valide" domain="[('state','=','valide')]"/>
                <filter string="En cours de validation" name="en_cours"
                        domain="[('state','in',['revue_interne','soumission_ethique','avis_ethique_recu'])]"/>
                <filter string="Brouillons" name="brouillon" domain="[('state','=','brouillon')]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Domaine" name="gr_domaine" context="{'group_by':'domaine_recherche_ids'}"/>
                    <filter string="Statut" name="gr_state" context="{'group_by':'state'}"/>
                    <filter string="Investigateur" name="gr_pi" context="{'group_by':'investigateur_principal_id'}"/>
                    <filter string="Année" name="gr_annee" context="{'group_by':'date_creation:year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_protocole_recherche" model="ir.actions.act_window">
        <field name="name">Protocoles de Recherche</field>
        <field name="res_model">resade.protocole.recherche</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_protocole_recherche_search"/>
        <field name="context">{'search_default_en_cours': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre premier protocole de recherche</p>
            <p>Processus P-CI-01 — Conception et validation d un protocole de recherche</p>
        </field>
    </record>

</odoo>

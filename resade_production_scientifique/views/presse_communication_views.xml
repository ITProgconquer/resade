<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_presse_communication_form" model="ir.ui.view">
        <field name="name">resade.presse.communication.form</field>
        <field name="model">resade.presse.communication</field>
        <field name="arch" type="xml">
            <form string="Communication Externe / Presse">
                <header>
                    <button name="action_soumettre_revue" string="Soumettre pour approbation"
                            type="object" class="btn-primary"
                            invisible="state != 'brouillon'"
                            groups="resade_production_scientifique.group_resade_scientifique_rc"/>

                    <button name="action_approuver" string="Approuver (DE)"
                            type="object" class="btn-success"
                            invisible="state != 'revue'"
                            groups="resade_production_scientifique.group_resade_scientifique_manager"/>

                    <button name="action_publier" string="Publier et Diffuser"
                            type="object" class="btn-success"
                            invisible="state != 'approuve'"
                            groups="resade_production_scientifique.group_resade_scientifique_rc"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="brouillon,revue,approuve,publie"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                        <h2><field name="titre" placeholder="Titre / Sujet..."/></h2>
                    </div>
                    <group>
                        <group string="Type et Canal">
                            <field name="type_action"/>
                            <field name="canal"/>
                            <field name="public_cible"/>
                            <field name="organe_presse"/>
                            <field name="journaliste_contact"/>
                        </group>
                        <group string="Responsables et Dates">
                            <field name="responsable_id"/>
                            <field name="approbateur_id"/>
                            <field name="date_creation"/>
                            <field name="date_approbation"/>
                            <field name="date_publication"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contenu">
                            <field name="contenu" placeholder="Contenu / Message principal..."/>
                        </page>
                        <page string="Fichiers">
                            <group>
                                <group string="Document">
                                    <field name="document" filename="document_filename" widget="binary"/>
                                    <field name="document_filename"/>
                                    <field name="url_diffusion"/>
                                </group>
                                <group string="Visuel">
                                    <field name="image_principale" filename="image_filename" widget="binary"/>
                                    <field name="image_filename"/>
                                </group>
                            </group>
                        </page>
                        <page string="Retombées et Impact">
                            <group>
                                <field name="portee_estimee"/>
                            </group>
                            <field name="retombees" placeholder="Retombées presse, réactions, partages..."/>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_presse_communication_list" model="ir.ui.view">
        <field name="name">resade.presse.communication.list</field>
        <field name="model">resade.presse.communication</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'publie'"
                  decoration-warning="state == 'revue'">
                <field name="reference"/>
                <field name="titre"/>
                <field name="type_action"/>
                <field name="canal"/>
                <field name="responsable_id"/>
                <field name="date_publication"/>
                <field name="portee_estimee"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_presse_communication" model="ir.actions.act_window">
        <field name="name">Relations Presse et Communication Externe</field>
        <field name="res_model">resade.presse.communication</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune action de communication enregistrée</p>
            <p>Processus P-CI-10 — Relations presse et communication externe RESADE</p>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bibliotheque_form" model="ir.ui.view">
        <field name="name">resade.bibliotheque.form</field>
        <field name="model">resade.bibliotheque</field>
        <field name="arch" type="xml">
            <form string="Bibliothèque RESADE">
                <header>
                    <button name="action_publier" string="Publier"
                            type="object" class="btn-success"
                            invisible="state != 'a_publier'"
                            groups="resade_production_scientifique.group_resade_scientifique_rc"/>
                    <button name="action_archiver" string="Archiver"
                            type="object"
                            invisible="state != 'publie'"
                            groups="resade_production_scientifique.group_resade_scientifique_manager"/>
                    <button name="action_a_publier" string="À publier"
                            type="object" class="btn-secondary"
                            invisible="state != 'brouillon'"
                            groups="resade_production_scientifique.group_resade_scientifique_rc"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="brouillon,a_publier,publie"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                        <h2><field name="titre" placeholder="Titre..."/></h2>
                        <field name="sous_titre" placeholder="Sous-titre (optionnel)..."/>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="type_document"/>
                            <field name="langue"/>
                            <field name="thematique_ids" widget="many2many_tags"/>
                            <field name="mots_cles"/>
                            <field name="open_access"/>
                        </group>
                        <group string="Auteurs et Dates">
                            <field name="auteur_principal_id"/>
                            <field name="auteurs_txt"/>
                            <field name="responsable_publication_id"/>
                            <field name="date_publication"/>
                        </group>
                    </group>
                    <group>
                        <group string="Identifiants et Liens">
                            <field name="doi"/>
                            <field name="url_externe"/>
                            <field name="url_site_resade"/>
                        </group>
                        <group string="Sources liées">
                            <field name="article_id"/>
                            <field name="soumission_id"/>
                        </group>
                    </group>
                    <group string="Visibilité site RESADE">
                        <group>
                            <field name="visible_site"/>
                            <field name="featured"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Résumé">
                            <field name="resume" placeholder="Résumé / Abstract du document..."/>
                        </page>
                        <page string="Fichiers">
                            <group>
                                <group string="Document PDF">
                                    <field name="fichier" filename="fichier_filename" widget="binary"/>
                                    <field name="fichier_filename"/>
                                </group>
                                <group string="Image de couverture">
                                    <field name="couverture" filename="couverture_filename" widget="binary"/>
                                    <field name="couverture_filename"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes internes">
                            <field name="notes" placeholder="Notes internes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bibliotheque_list" model="ir.ui.view">
        <field name="name">resade.bibliotheque.list</field>
        <field name="model">resade.bibliotheque</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'publie'"
                  decoration-warning="state == 'a_publier'">
                <field name="reference"/>
                <field name="titre"/>
                <field name="type_document"/>
                <field name="langue"/>
                <field name="auteur_principal_id"/>
                <field name="date_publication"/>
                <field name="open_access" widget="boolean_toggle"/>
                <field name="visible_site" widget="boolean_toggle"/>
                <field name="doi"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_bibliotheque_kanban" model="ir.ui.view">
        <field name="name">resade.bibliotheque.kanban</field>
        <field name="model">resade.bibliotheque</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="titre"/>
                <field name="type_document"/>
                <field name="auteur_principal_id"/>
                <field name="date_publication"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <strong><field name="titre"/></strong>
                                <div class="text-muted">
                                    <field name="type_document"/> — <field name="date_publication"/>
                                </div>
                                <div><field name="auteur_principal_id"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_bibliotheque_search" model="ir.ui.view">
        <field name="name">resade.bibliotheque.search</field>
        <field name="model">resade.bibliotheque</field>
        <field name="arch" type="xml">
            <search>
                <field name="titre"/>
                <field name="auteur_principal_id"/>
                <field name="thematique_ids"/>
                <field name="mots_cles"/>
                <separator/>
                <filter string="Publiés" name="publie" domain="[('state','=','publie')]"/>
                <filter string="Open Access" name="oa" domain="[('open_access','=',True)]"/>
                <filter string="Visibles sur le site" name="site" domain="[('visible_site','=',True)]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Type de document" name="gr_type" context="{'group_by':'type_document'}"/>
                    <filter string="Année" name="gr_annee" context="{'group_by':'annee'}"/>
                    <filter string="Langue" name="gr_langue" context="{'group_by':'langue'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bibliotheque" model="ir.actions.act_window">
        <field name="name">Bibliothèque en ligne</field>
        <field name="res_model">resade.bibliotheque</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_bibliotheque_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun document dans la bibliothèque</p>
            <p>Processus P-CI-08 — Gestion du site web et de la bibliothèque en ligne RESADE</p>
        </field>
    </record>

    <record id="action_resade_thematique" model="ir.actions.act_window">
        <field name="name">Thématiques de recherche</field>
        <field name="res_model">resade.thematique</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

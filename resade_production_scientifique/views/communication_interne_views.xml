<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_communication_interne_form" model="ir.ui.view">
        <field name="name">resade.communication.interne.form</field>
        <field name="model">resade.communication.interne</field>
        <field name="arch" type="xml">
            <form string="Communication Interne">
                <header>
                    <button name="action_marquer_tenu" string="Marquer comme tenu"
                            type="object" class="btn-primary"
                            invisible="state != 'planifie'"/>
                    <button name="action_pv_redige" string="PV rédigé"
                            type="object"
                            invisible="state != 'tenu'"/>
                    <button name="action_pv_approuve" string="PV approuvé et Diffusé"
                            type="object" class="btn-success"
                            invisible="state != 'pv_redige'"
                            groups="resade_production_scientifique.group_resade_scientifique_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="planifie,tenu,pv_redige,pv_approuve"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                        <h2><field name="objet" placeholder="Objet / Titre..."/></h2>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="type_communication"/>
                            <field name="animateur_id"/>
                            <field name="participants_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Logistique">
                            <field name="date_reunion"/>
                            <field name="duree_heures"/>
                            <field name="lieu"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ordre du jour et Décisions">
                            <field name="ordre_du_jour" placeholder="Points à l ordre du jour..."/>
                            <field name="decisions" placeholder="Décisions prises..."/>
                            <field name="points_action" placeholder="Qui fait quoi et quand..."/>
                        </page>
                        <page string="Documents">
                            <group>
                                <group string="PV">
                                    <field name="pv" filename="pv_filename" widget="binary"/>
                                    <field name="pv_filename"/>
                                    <field name="diffuse"/>
                                    <field name="date_diffusion" invisible="not diffuse"/>
                                </group>
                                <group string="Supports">
                                    <field name="support_presentation" filename="support_filename" widget="binary"/>
                                    <field name="support_filename"/>
                                    <field name="liste_presence" filename="liste_presence_filename" widget="binary"/>
                                    <field name="liste_presence_filename"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Notes complémentaires..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_communication_interne_list" model="ir.ui.view">
        <field name="name">resade.communication.interne.list</field>
        <field name="model">resade.communication.interne</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'pv_approuve'"
                  decoration-info="state == 'tenu'">
                <field name="reference"/>
                <field name="objet"/>
                <field name="type_communication"/>
                <field name="animateur_id"/>
                <field name="date_reunion"/>
                <field name="diffuse" widget="boolean_toggle"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_communication_calendar" model="ir.ui.view">
        <field name="name">resade.communication.interne.calendar</field>
        <field name="model">resade.communication.interne</field>
        <field name="arch" type="xml">
            <calendar string="Calendrier Réunions" date_start="date_reunion"
                      color="type_communication" mode="month">
                <field name="objet"/>
                <field name="animateur_id"/>
            </calendar>
        </field>
    </record>

    <record id="action_communication_interne" model="ir.actions.act_window">
        <field name="name">Communications Internes</field>
        <field name="res_model">resade.communication.interne</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucune communication enregistrée</p>
            <p>Processus P-CI-06 — Communication interne RESADE</p>
        </field>
    </record>
</odoo>

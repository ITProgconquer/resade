<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════ LISTE ═══════════════ -->
    <record id="view_resade_rapport_list" model="ir.ui.view">
        <field name="name">resade.rapport.projet.list</field>
        <field name="model">resade.rapport.projet</field>
        <field name="arch" type="xml">
            <list string="Rapports d'Avancement">
                <field name="name"/>
                <field name="projet_id"/>
                <field name="type_rapport"/>
                <field name="date_rapport"/>
                <field name="taux_execution_technique_rapport"/>
                <field name="valide_par_rp"/>
                <field name="approuve_par_de"/>
                <field name="soumis_au_bailleur"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════ FORMULAIRE ═══════════════ -->
    <record id="view_resade_rapport_form" model="ir.ui.view">
        <field name="name">resade.rapport.projet.form</field>
        <field name="model">resade.rapport.projet</field>
        <field name="arch" type="xml">
            <form string="Rapport d'Avancement (P-EST-02)">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Intitulé du rapport"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="projet_id"/>
                            <field name="type_rapport"/>
                            <field name="date_rapport"/>
                            <field name="date_soumission_bailleur"
                                   invisible="type_rapport in ['mensuel', 'incident']"/>
                        </group>
                        <group string="Période">
                            <field name="periode_debut"/>
                            <field name="periode_fin"/>
                        </group>
                    </group>
                    <group string="Taux d'exécution">
                        <field name="taux_execution_technique_rapport"/>
                        <field name="taux_execution_financier_rapport"/>
                    </group>
                    <group string="Contenu du rapport">
                        <field name="contenu_narratif" nolabel="1"/>
                    </group>
                    <group string="Validations">
                        <field name="valide_par_rp"
                            groups="resade_projet_h.group_resade_rp"/>
                        <field name="valide_par_cdp"
                            groups="resade_projet_h.group_resade_cdp"/>
                        <field name="approuve_par_de"
                               invisible="type_rapport in ['mensuel', 'incident']"
                               groups="resade_projet_h.group_resade_de_projet"/>
                        <field name="soumis_au_bailleur"
                               invisible="type_rapport in ['mensuel', 'incident']"
                               groups="resade_projet_h.group_resade_de_projet"/>
                        <field name="accuse_reception_bailleur"
                               invisible="type_rapport in ['mensuel', 'incident']"/>
                    </group>
                    <group string="Documents">
                        <field name="document_ids" widget="many2many_binary"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════ ACTION ═══════════════ -->
    <record id="action_resade_rapport" model="ir.actions.act_window">
        <field name="name">Rapports d'Avancement (P-EST-02)</field>
        <field name="res_model">resade.rapport.projet</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>